{
  "name": "mambo-video-library",
  "version": "1.0.0",
  "private": true,
  "description": "Searchable Mambo/Salsa training video library — Remotion-powered clip pipeline + web library",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "audit": "node scripts/audit.mjs",
    "prep": "node scripts/prep.mjs",
    "transcribe": "node scripts/transcribe.mjs",
    "segment": "node scripts/segment.mjs",
    "captions": "node scripts/captions.mjs",
    "render": "node scripts/render.mjs",
    "render:clip": "node scripts/render.mjs --id",
    "thumbnails": "node scripts/thumbnails.mjs",
    "qa": "node scripts/qa.mjs",
    "manifest": "node scripts/manifest.mjs",
    "revise": "node scripts/revise.mjs",
    "pipeline": "node scripts/pipeline.mjs",
    "library:dev": "vite --config app/vite.config.ts",
    "library:build": "vite build --config app/vite.config.ts",
    "library:preview": "vite preview --config app/vite.config.ts",
    "setup:whisper": "pip install --quiet faster-whisper",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.496",
    "@remotion/cli": "4.0.496",
    "@remotion/media": "4.0.496",
    "@remotion/renderer": "4.0.496",
    "fuse.js": "^7.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.3",
    "remotion": "4.0.496"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
