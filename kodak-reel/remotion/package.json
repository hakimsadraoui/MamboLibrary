    "remotion": "4.0.410"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "typescript": "5.9.3"
  },
  "remotion": {
    "entrypoint": "src/index.ts"
  }
